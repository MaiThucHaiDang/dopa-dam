# Copy to secrets.properties (not committed) and fill in, then rebuild. Leave empty to run without sync.
# Supabase: Project Settings > API. Only the anon (public) key here, never the service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Google Cloud: the *Web* OAuth client ID (the Android client only needs to exist with this app's SHA-1).
GOOGLE_WEB_CLIENT_ID=
